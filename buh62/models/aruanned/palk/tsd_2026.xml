<VFPData>
  <grid>
    <sql>with
                        params as (
                                      select
                                          case
                                              when $1::date &gt; $2::date then date(year($2::date), month($2::date), 1)
                                              else $1::date end::date as kpv1,
                                          $2::date                    as kpv2,
                                          r.id                        as rekv_id,
                                          $4::integer                 as kond,
                                          r.regkood
                                      from
                                          ou.rekv r
                                      where
                                          id = $3::integer

                                  ),
                        report as (
                                      select
                                          *
                                      FROM
                                          params                           p,
                                          palk.tsd_2026(p.kpv1::date, p.kpv2::date, p.rekv_id::integer,
                                                          p.kond::integer) qry
                                  )
                    select
                        r.*
                    from
                        report r
                    order by
                        r.isikukood, r.tululiik</sql>
    <alias>tsd_2026</alias>
  </grid>
